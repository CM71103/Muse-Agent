{
  "name": "muse-agent",
  "productName": "Muse Agent",
  "version": "0.1.7",
  "description": "Personal AI agent - Electron shell + Node harness",
  "license": "MIT",
  "main": "app/main/index.js",
  "scripts": {
    "start": "bun run build:renderer && electron .",
    "build:renderer": "bun scripts/build-renderer.mts",
    "agent": "node app/harness/cli.js",
    "test": "node --test app/harness/test/*.test.js app/harness/test/*.test.ts app/renderer/test/*.test.js scripts/test/*.test.mts",
    "release:check": "node scripts/release-check.mts",
    "dist": "bun run build:renderer && node scripts/check-native.js && node scripts/build-windows.mts --win",
    "dist:portable": "bun run build:renderer && node scripts/check-native.js && node scripts/build-windows.mts --win portable",
    "dist:dir": "bun run build:renderer && node scripts/check-native.js && node scripts/build-windows.mts --win --dir",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cn.muse.agent",
    "productName": "Muse Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "build/icon.ico",
      "config.example.toml",
      "!app/harness/test/**",
      "!app/renderer/test/**"
    ],
    "extraResources": [
      {
        "from": "config.example.toml",
        "to": "template.toml"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muse Agent",
      "uninstallDisplayName": "Muse Agent ${version}"
    },
    "portable": {
      "artifactName": "MuseAgent-${version}-portable.exe"
    },
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.82",
    "better-sqlite3": "^13.0.3"
  }
}

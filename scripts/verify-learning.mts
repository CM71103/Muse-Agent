import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {spawnSync} from 'node:child_process';

// Native render with disposable mocked learning history. No real API use or jobs.
const root=path.resolve(import.meta.dirname,'..'),require=createRequire(import.meta.url);
const base=fs.realpathSync.native(os.tmpdir()),temp=fs.mkdtempSync(path.join(base,'muse-learning-preview-')),output=path.join(root,'dist/learning-preview');fs.mkdirSync(output,{recursive:true});
const built=await Bun.build({entrypoints:[path.join(root,'scripts/renderer/learning-panel.ts')],target:'browser',format:'iife',minify:false});if(!built.success)throw Error('Learning panel compile failed');
const bundle=await built.outputs[0].text(),css=fs.readFileSync(path.join(root,'app/renderer/learning-panel.css'),'utf8');
const settings={enabled:false,review:true,practice:true,research:true,idle_minutes:5,interval_minutes:30,daily_token_cap:20000,topics:['Accessible interfaces'],sources:['https://example.com/documentation']};
const jobs=[{id:'fixture-review',kind:'review',status:'completed',tokens:410,started:'2026-11-09T08:30:00Z',summary:'Reviewed a disposable sample task and recorded a pattern.',lessons:[{id:'fixture-lesson',text:'Check keyboard navigation before declaring a new dialog complete.',kind:'review',verification:'observed',evidence:'A review observation, not proof of successful execution.',sources:[]}]},{id:'fixture-research',kind:'research',status:'completed',tokens:290,summary:'Sample source-backed learning note.',lessons:[{id:'fixture-source',text:'Use evidence links so saved notes can be checked later.',verification:'sourced',sources:['https://example.com/documentation','javascript:alert(1)']}]}];
fs.writeFileSync(path.join(temp,'preload.cjs'),`
const {contextBridge}=require('electron');let callback;let status={settings:${JSON.stringify(settings)},jobs:${JSON.stringify(jobs)},state:'disabled',practiceReady:false,practiceDetail:'Independent practice guest is not configured.',used_tokens:700,reserved_tokens:0},calls=[];
const update=patch=>{status={...status,...patch};return status};
const api={getConfig:async()=>({llm:{model:'Preview',visible_models:['Preview']},sentinel:{mode:'ask'},memory:{enabled:false}}),getProjectScope:async()=>({ok:true,project:null}),listProjects:async()=>[],listSessions:async()=>[],memoryStatus:async()=>({enabled:false}),boxStatus:async()=>({state:'disconnected'}),windowsStatus:async()=>({state:'unselected',selected:null}),sandboxStatus:async()=>({state:'missing_iso',available:false}),
learningStatus:async()=>status,learningSave:async settings=>{calls.push('save');return update({settings,state:settings.enabled?'waiting_for_idle':'disabled'})},learningRun:async kind=>{calls.push('queue:'+kind);return update({queued_kind:kind,state:'waiting_for_idle'})},learningPause:async()=>{calls.push('pause');return update({settings:{...status.settings,enabled:false},state:'paused',active:null,queued_kind:undefined})},learningDeleteLesson:async id=>{calls.push('delete:'+id);return update({jobs:status.jobs.map(job=>({...job,lessons:job.lessons.filter(lesson=>lesson.id!==id)}))})},onLearningStatus:fn=>{callback=fn;return()=>{callback=null}}};
for(const name of ['onAgentEvent','onApprovalRequest','onApprovalResolved','onApprovalExpired','onSessionReset','onQuestion','onBoxStatus'])api[name]=()=>()=>{};
contextBridge.exposeInMainWorld('muse',api);contextBridge.exposeInMainWorld('learningFixture',{calls:()=>calls,running:()=>{update({state:'running',active:{id:'fixture-active'}});callback?.(status)}});
`);
fs.writeFileSync(path.join(temp,'preview.cjs'),`
const {app,BrowserWindow}=require('electron'),fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');
const root=${JSON.stringify(root)},output=${JSON.stringify(output)};app.setPath('userData',path.join(__dirname,'profile'));app.commandLine.appendSwitch('disable-features','CalculateNativeWinOcclusion');let win;const errors=[],pause=ms=>new Promise(resolve=>setTimeout(resolve,ms));
app.whenReady().then(async()=>{try{
 win=new BrowserWindow({width:1280,height:900,useContentSize:true,show:false,webPreferences:{offscreen:true,preload:path.join(__dirname,'preload.cjs'),contextIsolation:true,nodeIntegration:false,sandbox:true,backgroundThrottling:false}});win.webContents.on('console-message',event=>{if(event.level==='error')errors.push(event.message)});win.webContents.on('did-fail-load',(_event,code,description)=>errors.push(code+': '+description));const js=code=>win.webContents.executeJavaScript(code),click=async id=>{await js('document.getElementById('+JSON.stringify(id)+').click()');await pause(100)},shot=async name=>{await pause(150);fs.writeFileSync(path.join(output,name+'.png'),(await win.webContents.capturePage()).toPNG())};
 await win.loadFile(path.join(root,'app/renderer/index.html'));win.webContents.startPainting();await js("document.getElementById('splash')?.remove()");
 if(!await js("!!document.getElementById('learning-open')")){await win.webContents.insertCSS(${JSON.stringify(css)});await js(${JSON.stringify(bundle)});await js('window.learningPreview=MuseLearning.create({api:window.muse,busy:()=>busy});void 0');}
 await click('learning-open');assert.equal(await js("document.getElementById('learning-enabled').checked"),false);assert.deepEqual(await js('learningFixture.calls()'),[],'Opening panel cannot run or save');assert.equal(await js("document.getElementById('learning-run-review').disabled"),true);assert.equal(await js("document.querySelectorAll('#learning-panel a[href^=javascript]').length"),0);
 await js("document.body.setAttribute('data-theme','dark')");await shot('disabled-dark');
 await js("document.getElementById('learning-enabled').checked=true;document.getElementById('learning-enabled').dispatchEvent(new Event('input',{bubbles:true}));document.getElementById('learning-form').requestSubmit()");await pause(150);assert.ok((await js('learningFixture.calls()')).includes('save'));await click('learning-run-review');assert.ok((await js('learningFixture.calls()')).includes('queue:review'));assert.match(await js("document.getElementById('learning-next').textContent"),/Queued: review/);
 await js('learningFixture.running()');await js('setBusy(true)');assert.equal(await js("document.getElementById('learning-pause').disabled"),false);await shot('running-dark');await click('learning-pause');assert.equal(await js("document.getElementById('learning-state').textContent"),'Paused');await js('setBusy(false)');
 await js("document.body.removeAttribute('data-theme')");await shot('paused-light');await js("document.querySelector('.learning-history').scrollIntoView({block:'start'})");await shot('lessons-light');win.setContentSize(320,700);await js("document.getElementById('learning-panel').scrollTop=0");await pause(150);await shot('narrow');assert.ok(await js("(()=>{const p=document.getElementById('learning-panel'),r=p.getBoundingClientRect();return r.left>=0&&r.right<=innerWidth&&p.scrollWidth<=p.clientWidth})()"),'Learning panel must fit 320px without horizontal scrolling');
 await js("document.querySelector('.learning-lesson button').click()");await pause(150);assert.ok((await js('learningFixture.calls()')).includes('delete:fixture-lesson'));await js("document.getElementById('learning-panel').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}))");assert.equal(await js("document.getElementById('learning-backdrop').hidden"),true);assert.deepEqual(errors,[]);
 console.log('PASS: native Learning dark/light/320px previews; explicit opt-in save; queued idle work; busy Pause; safe evidence; lesson deletion; Escape.');win.destroy();app.exit(0);
}catch(error){console.error(error);if(win)win.destroy();app.exit(1)}});setTimeout(()=>app.exit(1),25000).unref();
`);
const env={...process.env};delete env.ELECTRON_RUN_AS_NODE;
try{const result=spawnSync(require('electron'),[path.join(temp,'preview.cjs')],{cwd:root,env,windowsHide:true,stdio:'inherit',timeout:30000});if(result.error||result.status!==0)throw result.error||Error('Native Learning UI verification failed');}
finally{assert.equal(path.dirname(fs.realpathSync.native(temp)).toLowerCase(),base.toLowerCase());fs.rmSync(temp,{recursive:true,force:true,maxRetries:10,retryDelay:250});}
